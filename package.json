{
  "name": "tigercs",
  "version": "1.0.0",
  "description": "SSU CS Advisory Board website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel \"dev:*\"",
    "dev:eleventy": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/style.css --watch",
    "build": "npm-run-all build:css build:eleventy",
    "build:eleventy": "eleventy",
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/style.css --minify"
  },
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.9",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  }
}
