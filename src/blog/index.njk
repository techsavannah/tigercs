---
layout: base.njk
title: Blog
permalink: /blog/
eleventyExcludeFromCollections: true
---
<h1 class="text-3xl font-bold mb-6">Blog</h1>
<ul class="space-y-4">
  {%- for post in collections.posts | reverse %}
  <li>
    <a class="link link-hover text-xl" href="{{ post.url }}">{{ post.data.title }}</a>
    <p class="text-sm opacity-60">{{ post.date | readableDate }}</p>
  </li>
  {%- endfor %}
</ul>
