<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title and (title + " | " + site.title) or site.title }}</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="navbar bg-base-100 shadow-sm px-4">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl">{{ site.title }}</a>
      </div>
      <nav class="flex-none">
        <ul class="menu menu-horizontal px-1">
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </header>

    <main class="flex-1 container mx-auto px-4 py-8">
      {{ content | safe }}
    </main>

    <footer class="footer footer-center bg-base-200 text-base-content p-4">
      <p>&copy; {% year %} {{ site.title }}</p>
    </footer>
  </body>
</html>
