<!doctype html>
<html lang="en" data-theme="ssu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title and (title + " | " + site.title) or site.title }}</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="navbar bg-base-100/80 backdrop-blur shadow-sm px-4">
      <div class="navbar-start">
        <div class="dropdown lg:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-square">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
            </svg>
          </div>
          <ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow">
            {%- for item in site.nav %}
            <li><a href="{{ item.url }}">{{ item.text }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <a href="/" class="btn btn-ghost text-xl">{{ site.title }}</a>
      </div>
      <nav class="navbar-end hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </header>

    <main class="flex-1 container mx-auto px-4 py-8 bg-base-100 rounded-box shadow-sm my-4">
      {{ content | safe }}
    </main>

    <footer class="footer footer-center bg-base-200/80 backdrop-blur text-base-content p-4">
      <p>&copy; {% year %} {{ site.title }}</p>
    </footer>
  </body>
</html>
